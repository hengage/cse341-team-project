<%- include('../partials/header') %>
<h1><%= title %></h1>

<div class="routes-grid" id="admin-routes-grid">
    <p>Loading trips...</p>
</div>

<template id="trip-admin-template">
    <div class="route-card">
        <h2 class="route-name"></h2>
        <button class="edit-btn">Edit</button>
        <button class="delete-btn">Delete</button>
    </div>
</template>

<script>
    async function fetchTrips() {
        const response = await fetch('/api/trips');
        const trips = await response.json();
        renderTrips(trips);
    }

    function renderTrips(trips) {
        const grid = document.getElementById('admin-routes-grid');
        grid.innerHTML = '';
        const template = document.getElementById('trip-admin-template');

        trips.forEach(trip => {
            const clone = template.content.cloneNode(true);
            clone.querySelector('.route-name').textContent = trip.name;
            
            // Delete functionality
            clone.querySelector('.delete-btn').onclick = async () => {
                if(confirm('Are you sure you want to delete this trip?')) {
                    const response = await fetch(`/api/admin/trips/${trip.id}`, { method: 'DELETE' });
                    if (response.ok) {
                        fetchTrips(); // Refresh the list
                    } else {
                        alert('Failed to delete trip');
                    }
                }
            };
            
            // Edit functionality (placeholder - could trigger a modal or form)
            clone.querySelector('.edit-btn').onclick = () => {
                alert('Edit functionality would be implemented here with a form.');
            };
            
            grid.appendChild(clone);
        });
    }

    fetchTrips();
</script>

<%- include('../partials/footer') %>
