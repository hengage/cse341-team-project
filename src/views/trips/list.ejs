<%- include('../partials/header') %>
<h1><%- title %></h1>

<div id="filters">
    Search by Region:
    <select id="region-filter">
        <option value="all">All Regions</option>
    </select>

    Search by Season:
    <select id="season-filter">
        <option value="all">Any Season</option>
    </select>
</div>

<div class="routes-grid" id="routes-grid">
    <!-- Content will be populated by JavaScript -->
</div>

<template id="route-card-template">
    <div class="route-card" id="region-container">
        <div class="route-header">
            <h2 class="route-name"></h2>
            <span class="route-region"></span>
        </div>

        <div class="station-info">
            <div class="station">
                <div class="station-type">From:</div>
                <div class="station-name"></div>
            </div>
            <div class="route-arrow">&#8594;</div>
            <div class="station">
                <div class="station-type">To:</div>
                <div class="station-name"></div>
            </div>
        </div>

        <div class="route-details">
            <div class="detail-item">
                <span class="detail-icon">&#128337;</span>
                <span><span class="detail-label">Duration:</span> <span class="duration"></span></span>
            </div>
            <div class="detail-item">
                <span class="detail-icon">&#128205;</span>
                <span><span class="detail-label">Distance:</span> <span class="distance"></span>km</span>
            </div>
            <div class="detail-item">
                <span class="season-badge">
                    Best in <span class="best-season"></span>
                </span>
            </div>
        </div>

        <div class="route-description"></div>

        <div class="highlights">
            <div class="highlights-list"></div>
        </div>
                
        <div class="route-actions">
            <a href="#" class="view-details-btn">
                View Details &amp; Book &#8594;
            </a>
        </div>
    </div>
</template>

<script>
    async function fetchTrips() {
        try {
            const response = await fetch('/api/trips');
            if (!response.ok) {
                throw new Error('Failed to fetch trips');
            }
            const trips = await response.json();
            renderTrips(trips);
        } catch (error) {
            console.error('Error fetching trips:', error);
            document.getElementById('routes-grid').innerHTML = '<p>Error loading trips. Please try again later.</p>';
        }
    }

    function renderTrips(trips) {
        const grid = document.getElementById('routes-grid');
        grid.innerHTML = '';
        const template = document.getElementById('route-card-template');

        trips.forEach(trip => {
            const clone = template.content.cloneNode(true);
            
            // Add ID for potential debugging
            const card = clone.querySelector('.route-card');
            if (card) {
                card.classList.add(trip.region);
            }

            const routeName = clone.querySelector('.route-name');
            if (routeName) routeName.textContent = trip.name;
            
            const routeRegion = clone.querySelector('.route-region');
            if (routeRegion) routeRegion.textContent = trip.region;
            
            const stationNames = clone.querySelectorAll('.station-name');
            if (stationNames.length >= 2) {
                stationNames[0].textContent = trip.startStation;
                stationNames[1].textContent = trip.endStation;
            }
            
            const duration = clone.querySelector('.duration');
            if (duration) duration.textContent = trip.duration;
            
            const distance = clone.querySelector('.distance');
            if (distance) distance.textContent = trip.distance;
            
            const bestSeason = clone.querySelector('.best-season');
            if (bestSeason) bestSeason.textContent = trip.bestSeason;
            
            const seasonBadge = clone.querySelector('.season-badge');
            if (seasonBadge) seasonBadge.classList.add('season-' + trip.bestSeason);
            
            const description = clone.querySelector('.route-description');
            if (description) description.textContent = trip.description;
            
            const highlightsList = clone.querySelector('.highlights-list');
            if (highlightsList && trip.highlights) {
                trip.highlights.forEach(h => {
                    const tag = document.createElement('span');
                    tag.className = 'highlight-tag';
                    tag.textContent = h;
                    highlightsList.appendChild(tag);
                });
            }
            
            const viewDetailsBtn = clone.querySelector('.view-details-btn');
            if (viewDetailsBtn) viewDetailsBtn.href = `/trips/${trip.id}`;
            
            grid.appendChild(clone);
        });
    }

    fetchTrips();
</script>

<%- include('../partials/footer') %>
