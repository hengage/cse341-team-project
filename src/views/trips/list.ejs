<%- include('../partials/header') %>
<h1><%- title %></h1>

<div id="filters">
    Search by Region:
    <select id="region-filter">
        <option value="all">All Regions</option>
    </select>

    Search by Season:
    <select id="season-filter">
        <option value="all">Any Season</option>
    </select>
</div>

<div class="routes-grid" id="routes-grid">
    <!-- Content will be populated by JavaScript -->
</div>

<template id="route-card-template">
    <div class="route-card" id="region-container">
        <div class="route-header">
            <h2 class="route-name"></h2>
            <span class="route-region"></span>
        </div>

        <div class="station-info">
            <div class="station">
                <div class="station-type">From:</div>
                <div class="station-name"></div>
            </div>
            <div class="route-arrow">&#8594;</div>
            <div class="station">
                <div class="station-type">To:</div>
                <div class="station-name"></div>
            </div>
        </div>

        <div class="route-details">
            <div class="detail-item">
                <span class="detail-icon">&#128337;</span>
                <span><span class="detail-label">Duration:</span> <span class="duration"></span></span>
            </div>
            <div class="detail-item">
                <span class="detail-icon">&#128205;</span>
                <span><span class="detail-label">Distance:</span> <span class="distance"></span>km</span>
            </div>
            <div class="detail-item">
                <span class="season-badge">
                    Best in <span class="best-season"></span>
                </span>
            </div>
        </div>

        <div class="route-description"></div>

        <div class="highlights">
            <div class="highlights-list"></div>
        </div>
                
        <div class="route-actions">
            <a href="#" class="view-details-btn">
                View Details &amp; Book &#8594;
            </a>
        </div>
    </div>
</template>

<script>
    async function fetchTrips() {
        try {
            const response = await fetch('/api/trips');
            if (!response.ok) {
                throw new Error('Failed to fetch trips');
            }
            const trips = await response.json();
            renderTrips(trips);
        } catch (error) {
            document.getElementById('routes-grid').innerHTML = '<p>Error loading trips. Please try again later.</p>';
        }
    }

    function renderTrips(trips) {
        const grid = document.getElementById('routes-grid');
        grid.innerHTML = '';
        const template = document.getElementById('route-card-template');

        trips.forEach(trip => {
            const clone = template.content.cloneNode(true);
            clone.querySelector('.route-card').classList.add(trip.region);
            clone.querySelector('.route-name').textContent = trip.name;
            clone.querySelector('.route-region').textContent = trip.region;
            clone.querySelector('.station-name:first-of-type').textContent = trip.startStation;
            clone.querySelector('.station-name:last-of-type').textContent = trip.endStation;
            clone.querySelector('.duration').textContent = trip.duration;
            clone.querySelector('.distance').textContent = trip.distance;
            clone.querySelector('.best-season').textContent = trip.bestSeason;
            clone.querySelector('.season-badge').classList.add('season-' + trip.bestSeason);
            clone.querySelector('.route-description').textContent = trip.description;
            
            const highlightsList = clone.querySelector('.highlights-list');
            trip.highlights.forEach(h => {
                const tag = document.createElement('span');
                tag.className = 'highlight-tag';
                tag.textContent = h;
                highlightsList.appendChild(tag);
            });
            
            clone.querySelector('.view-details-btn').href = `/trips/${trip.id}`;
            grid.appendChild(clone);
        });
    }

    fetchTrips();
</script>

<%- include('../partials/footer') %>
