<%- include('../partials/header') %>
<h1><%- title %></h1>

<div id="filters">
    Search: <input type="text" id="search-input" placeholder="Search trips...">
    Region:
    <select id="region-filter">
        <option value="">All Regions</option>
        <option value="central">Central</option>
        <option value="northern">Northern</option>
        <option value="kansai">Kansai</option>
        <option value="hokkaido">Hokkaido</option>
    </select>

    Season:
    <select id="season-filter">
        <option value="">Any Season</option>
        <option value="spring">Spring</option>
        <option value="summer">Summer</option>
        <option value="autumn">Autumn</option>
        <option value="winter">Winter</option>
    </select>
    <button id="apply-filters">Apply</button>
</div>

<div class="routes-grid" id="routes-grid">
    <!-- Content will be populated by JavaScript -->
</div>

<div id="pagination-controls">
    <button id="prev-page">Previous</button>
    <span id="page-info"></span>
    <button id="next-page">Next</button>
</div>

<template id="route-card-template">
    <div class="route-card">
        <div class="route-header">
            <h2 class="route-name"></h2>
            <span class="route-region"></span>
        </div>

        <div class="station-info">
            <div class="station">
                <div class="station-type">From:</div>
                <div class="station-name"></div>
            </div>
            <div class="route-arrow">&#8594;</div>
            <div class="station">
                <div class="station-type">To:</div>
                <div class="station-name"></div>
            </div>
        </div>

        <div class="route-details">
            <div class="detail-item">
                <span class="detail-icon">&#128337;</span>
                <span><span class="detail-label">Duration:</span> <span class="duration"></span></span>
            </div>
            <div class="detail-item">
                <span class="detail-icon">&#128205;</span>
                <span><span class="detail-label">Distance:</span> <span class="distance"></span>km</span>
            </div>
            <div class="detail-item">
                <span class="season-badge">
                    Best in <span class="best-season"></span>
                </span>
            </div>
        </div>

        <div class="route-description"></div>

        <div class="highlights">
            <div class="highlights-list"></div>
        </div>
                
        <div class="route-actions">
            <a href="#" class="view-details-btn">
                View Details &amp; Book &#8594;
            </a>
        </div>
    </div>
</template>

<script>
    let currentPage = 1;

    async function fetchTrips(page = 1) {
        const q = document.getElementById('search-input').value;
        const region = document.getElementById('region-filter').value;
        const bestSeason = document.getElementById('season-filter').value;
        
        const params = new URLSearchParams({ page, limit: 10 });
        if (q) params.append('q', q);
        if (region) params.append('region', region);
        if (bestSeason) params.append('bestSeason', bestSeason);
        
        console.log('Debug - Fetch URL:', `/api/trips?${params.toString()}`);
        
        try {
            const response = await fetch(`/api/trips?${params.toString()}`);
            if (!response.ok) throw new Error('Failed to fetch trips');
            const result = await response.json();
            renderTrips(result.data);
            updatePagination(result.pagination);
        } catch (error) {
            console.error('Error:', error);
            document.getElementById('routes-grid').innerHTML = '<p>Error loading trips.</p>';
        }
    }

    function renderTrips(trips) {
        const grid = document.getElementById('routes-grid');
        grid.innerHTML = '';
        const template = document.getElementById('route-card-template');

        trips.forEach(trip => {
            const clone = template.content.cloneNode(true);
            
            const card = clone.querySelector('.route-card');
            card.classList.add(trip.region);

            clone.querySelector('.route-name').textContent = trip.name;
            clone.querySelector('.route-region').textContent = trip.region;
            
            const stations = clone.querySelectorAll('.station-name');
            stations[0].textContent = trip.startStation;
            stations[1].textContent = trip.endStation;
            
            clone.querySelector('.duration').textContent = trip.duration;
            clone.querySelector('.distance').textContent = trip.distance;
            clone.querySelector('.best-season').textContent = trip.bestSeason;
            clone.querySelector('.season-badge').classList.add('season-' + trip.bestSeason);
            clone.querySelector('.route-description').textContent = trip.description;
            
            const highlightsList = clone.querySelector('.highlights-list');
            if (highlightsList && trip.highlights) {
                trip.highlights.forEach(h => {
                    const tag = document.createElement('span');
                    tag.className = 'highlight-tag';
                    tag.textContent = h;
                    highlightsList.appendChild(tag);
                });
            }
            
            clone.querySelector('.view-details-btn').href = `/trips/${trip.id}`;
            grid.appendChild(clone);
        });
    }

    function updatePagination(pagination) {
        currentPage = pagination.page;
        document.getElementById('page-info').textContent = `Page ${pagination.page} of ${pagination.totalPages}`;
        document.getElementById('prev-page').disabled = !pagination.hasPreviousPage;
        document.getElementById('next-page').disabled = !pagination.hasNextPage;
    }

    document.addEventListener('DOMContentLoaded', () => {
        document.getElementById('apply-filters').onclick = () => fetchTrips(1);
        document.getElementById('prev-page').onclick = () => fetchTrips(currentPage - 1);
        document.getElementById('next-page').onclick = () => fetchTrips(currentPage + 1);
        fetchTrips();
    });
</script>

<%- include('../partials/footer') %>
