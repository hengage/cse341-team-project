<%- include('./partials/header') %>

<h1 class="confirmation-title"><%= title %></h1>

<form id="booking-filters">
    <label for="booking-ticket-class">
        Ticket class
        <select id="booking-ticket-class" name="ticketClass">
            <option value="">All ticket classes</option>
            <option value="standard">Standard</option>
            <option value="premium">Premium</option>
            <option value="first">First</option>
        </select>
    </label>

    <label for="booking-start-date">
        Start date
        <input id="booking-start-date" name="startDate" type="date">
    </label>

    <label for="booking-end-date">
        End date
        <input id="booking-end-date" name="endDate" type="date">
    </label>

    <button type="submit">Apply Filters</button>
    <button id="booking-clear-filters" type="button">Clear Filters</button>
</form>

<p id="bookings-loading" role="status">Loading bookings...</p>
<p id="bookings-error" role="alert" hidden></p>
<p id="bookings-empty" hidden>No bookings found.</p>
<div id="bookings-list"></div>
<nav id="bookings-pagination" aria-label="Booking pages" hidden>
    <button id="bookings-previous" type="button" disabled>Previous</button>
    <p id="bookings-page-info" aria-live="polite"></p>
    <button id="bookings-next" type="button" disabled>Next</button>
</nav>

<template id="booking-card-template">
    <article class="booking-card">
        <div id="booking-reference">
            <p>Booking Reference:</p>
        </div>

        <div id="ticket-class">
            <p>Ticket Class:</p>
        </div>

        <div id="selected-day">
            <p>Selected Day:</p>
        </div>

        <div id="booked-on">
            <p>Booked On:</p>
        </div>

        <div id="passengers">
            <p>Passengers:</p>
        </div>
    </article>
</template>

<template id="passenger-card-template">
    <article class="passenger-card">
        <p id="passenger-name">Passenger Name: </p>
        <p id="passenger-email">Passenger Email: </p>
        <p id="passenger-phone">Passenger Phone: </p>
    </article>
</template>
<%- include('./partials/footer') %>